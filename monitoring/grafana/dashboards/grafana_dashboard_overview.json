{
  "dashboard": {
    "title": "ML System Overview",
    "uid": "mlops-overview",
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "stat",
        "title": "System Health",
        "targets": [
          {
            "expr": "service_health{service=\"aqi_api\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            },
            "mappings": [
              {"type": "value", "value": 0, "text": "Unhealthy"},
              {"type": "value", "value": 1, "text": "Healthy"}
            ]
          }
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "type": "graph",
        "title": "Prediction Rate",
        "targets": [
          {
            "expr": "rate(predictions_total[5m])",
            "legendFormat": "{{model}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"}
        ]
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "type": "graph",
        "title": "Prediction Latency",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(prediction_duration_seconds_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.5, rate(prediction_duration_seconds_bucket[5m]))",
            "legendFormat": "p50",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration"}
        ]
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "type": "graph",
        "title": "Model Performance",
        "targets": [
          {
            "expr": "model_mae",
            "legendFormat": "MAE",
            "refId": "A"
          },
          {
            "expr": "model_r2",
            "legendFormat": "R²",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Value"}
        ]
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "type": "graph",
        "title": "Model Drift",
        "targets": [
          {
            "expr": "model_drift_psi",
            "legendFormat": "PSI Score",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "PSI"}
        ],
        "thresholds": [
          {"value": 0.1, "colorMode": "custom", "fill": false, "line": true, "op": "gt"},
          {"value": 0.3, "colorMode": "custom", "fill": false, "line": true, "op": "gt"}
        ]
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "type": "stat",
        "title": "Error Rate",
        "targets": [
          {
            "expr": "rate(predictions_errors_total[5m]) / rate(predictions_total[5m]) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
        "type": "table",
        "title": "Active Health Checks",
        "targets": [
          {
            "expr": "health_check_status",
            "refId": "A",
            "format": "table"
          }
        ]
      }
    ]
  }
}
